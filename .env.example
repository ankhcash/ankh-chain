# Copy to .env in this directory. Loaded automatically at startup.

# Derive the face descriptor on this node from the submitted image instead of
# trusting the client's. Required for the node's consensus vote to mean
# "I verified this myself" rather than "it is not in my index".
# Needs: npm install  (tfjs, tfjs-backend-wasm, face-api, jpeg-js, pngjs)
ANKH_SERVER_SIDE_FACE=1

# Commit descriptors to the state root. CONSENSUS-AFFECTING: every node on the
# network must agree on this setting or peers reject each other's snapshots.
# ANKH_COMMIT_DESCRIPTORS=1

# Store descriptors int8-only: 210 B/entry instead of 839. Search stays
# conservative (never misses a duplicate) but reports quantised distances.
# ANKH_LEAN_DESCRIPTORS=1

# Allow verification with fewer than CONSENSUS_MIN_VOTES peers responding.
# UNSAFE: one node then decides who counts as a person. Bootstrap only.
# ANKH_ALLOW_SOLO_VERIFICATION=1
