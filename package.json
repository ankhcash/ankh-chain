{
  "name": "ankh-chain",
  "version": "1.1.0",
  "description": "Ankh Native Blockchain - Universal Basic Income for Humanity. Node, zero-dependency SDK, and CLI.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/run-all.js",
    "node": "node src/node.js",
    "test:security": "node test/security.test.js",
    "bench": "node test/descriptor-index.test.js",
    "test:all": "node test/run-all.js && node test/descriptor-index.test.js",
    "test:sdk": "node test/sdk-signer.test.js"
  },
  "keywords": [
    "blockchain",
    "ubi",
    "biometric",
    "universal-basic-income",
    "cryptocurrency",
    "ankh",
    "sdk",
    "cli"
  ],
  "author": "Ankh Foundation",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "bip39": "^3.1.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "elliptic": "^6.5.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "node-cron": "^3.0.3",
    "pngjs": "^7.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "./ankh-sdk.d.ts",
  "bin": {
    "ankh": "./bin/ankh.js"
  },
  "files": [
    "server.js",
    "ankh-sdk.js",
    "ankh-sdk.d.ts",
    "bin/",
    "src/",
    "scripts/",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "homepage": "https://ankh.cash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhcash/ankh-chain.git"
  },
  "bugs": {
    "url": "https://github.com/ankhcash/ankh-chain/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
